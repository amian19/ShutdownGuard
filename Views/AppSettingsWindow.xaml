<ui:FluentWindow x:Class="ShutdownGuard.Views.AppSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="600" Height="1000"
                 MinWidth="560" MinHeight="800"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 Icon="/Assets/IdlePulse.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/IdlePulse-512.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="28,8,28,12">
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Text="Advanced behavior, file locations, and app information."
                       Opacity="0.7"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Cards -->
        <ScrollViewer Grid.Row="2" Padding="20,4,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Scan interval -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Pulse24"
                                           FontSize="22"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Idle scan interval" FontWeight="SemiBold" />
                                <TextBlock Text="How often IdlePulse checks idle time. Lower = snappier; higher = lighter."
                                           Opacity="0.65" FontSize="12" Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:NumberBox x:Name="ScanIntervalBox"
                                              Value="5" Minimum="1" Maximum="3600"
                                              ClearButtonEnabled="False"
                                              SpinButtonPlacementMode="Inline"
                                              Width="140" />
                                <TextBlock Text="sec" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ScanIntervalHint"
                                   Margin="36,8,0,0"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Text="Default: 5s. Worst-case trigger lateness equals this value." />
                    </StackPanel>
                </ui:Card>

                <!-- Config file location -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="DocumentSettings20"
                                           FontSize="22"
                                           VerticalAlignment="Top"
                                           Margin="0,2,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Configuration file" FontWeight="SemiBold" />
                                <TextBlock Text="Settings are saved here as JSON."
                                           Opacity="0.65" FontSize="12" Margin="0,2,0,8" />
                                <TextBox x:Name="ConfigPathBox"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="8,6"
                                         Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ui:Button Content="Open folder"
                                               Click="OpenConfigFolder_Click"
                                               Margin="0,0,8,0">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Content="Copy path"
                                               Click="CopyConfigPath_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Copy24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Crash log -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="ErrorCircle24"
                                           FontSize="22"
                                           VerticalAlignment="Top"
                                           Margin="0,2,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Crash log" FontWeight="SemiBold" />
                                <TextBlock x:Name="CrashLogStatus"
                                           Text="No crashes recorded."
                                           Opacity="0.65" FontSize="12" Margin="0,2,0,8" />
                                <TextBox x:Name="CrashLogPathBox"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="8,6"
                                         Background="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ui:Button x:Name="OpenCrashLogButton"
                                               Content="Open log"
                                               Click="OpenCrashLog_Click"
                                               Margin="0,0,8,0">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="DocumentText24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="ClearCrashLogButton"
                                               Content="Clear"
                                               Appearance="Caution"
                                               Click="ClearCrashLog_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Clear startup -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Broom24"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Clear startup entries" FontWeight="SemiBold" />
                            <TextBlock Text="Safely remove any IdlePulse autostart registry values and Startup folder shortcuts."
                                       Opacity="0.65" FontSize="12" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   Content="Clear"
                                   Appearance="Caution"
                                   Click="ClearStartup_Click"
                                   VerticalAlignment="Center" />
                    </Grid>
                </ui:Card>

                <!-- Reset -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="ArrowReset24"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Reset app settings" FontWeight="SemiBold" />
                            <TextBlock Text="Restore app settings (scan interval) to defaults. Your Idle Trigger settings are preserved."
                                       Opacity="0.65" FontSize="12" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   Content="Reset"
                                   Appearance="Caution"
                                   Click="Reset_Click"
                                   VerticalAlignment="Center" />
                    </Grid>
                </ui:Card>

                <!-- About -->
                <ui:Card Margin="8,4,8,12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Info24"
                                       FontSize="22"
                                       VerticalAlignment="Top"
                                       Margin="0,2,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="About" FontWeight="SemiBold" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Opacity="0.65" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime" Opacity="0.65" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Executable" Opacity="0.65" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExePathText"
                                           FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="28,14,28,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Padding="20,6" Click="Cancel_Click" />
                <ui:Button Content="Save" Appearance="Primary" Padding="22,6" Click="Save_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
