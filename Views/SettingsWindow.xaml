<Window x:Class="ShutdownGuard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ShutdownGuard"
        Width="440" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#555555"/>
        <SolidColorBrush x:Key="HintBrush" Color="#6B6B6B"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand -->
        <TextBlock Grid.Row="0"
                   Text="ShutdownGuard"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TitleBrush}"
                   Margin="0,0,0,16"/>

        <!-- Section: Auto shutdown -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="自动关机"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="启用自动关机"
                           Foreground="{StaticResource LabelBrush}"
                           VerticalAlignment="Center"/>
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding Enabled, Mode=TwoWay}"/>
            </Grid>
        </StackPanel>

        <!-- Section: Reminder start -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="提醒开始时间"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="HourComboBox"
                          Width="72"
                          IsEnabled="{Binding Enabled}"
                          SelectedItem="{Binding ReminderHour, Mode=TwoWay}"
                          ItemStringFormat="{}{0:D2}"/>
                <TextBlock Text=" : "
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TitleBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0"/>
                <ComboBox x:Name="MinuteComboBox"
                          Width="72"
                          IsEnabled="{Binding Enabled}"
                          SelectedItem="{Binding ReminderMinute, Mode=TwoWay}"
                          ItemStringFormat="{}{0:D2}"/>
            </StackPanel>
            <TextBlock x:Name="ValidationErrorText"
                       Text="{Binding ValidationError}"
                       FontSize="11"
                       Foreground="#C62828"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Section: Fixed shutdown -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="固定关机时间"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{Binding FixedShutdownDisplay}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource LabelBrush}"/>
            <TextBlock Text="下次提醒"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,12,0,4"/>
            <TextBlock Text="{Binding NextReminderText}"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryBrush}"/>
            <TextBlock Text="本次计划关机"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,10,0,4"/>
            <TextBlock Text="{Binding ScheduledShutdownText}"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryBrush}"/>
        </StackPanel>

        <!-- Section: Safety -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="安全设置"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="安全测试模式"
                           Foreground="{StaticResource LabelBrush}"
                           VerticalAlignment="Center"/>
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding DryRun, Mode=TwoWay}"/>
            </Grid>
            <TextBlock Text="开启后会正常提醒，但最终执行阶段不会真正关闭电脑。"
                       FontSize="11"
                       Foreground="{StaticResource HintBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
            <TextBlock x:Name="DryRunWarningText"
                       Text="警告：关闭安全测试模式后，到达固定关机时间将真实关闭 Windows。"
                       FontSize="11"
                       Foreground="#C05600"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Section: System -->
        <StackPanel Grid.Row="5" Margin="0,0,0,16">
            <TextBlock Text="系统设置"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="开机自动启动"
                           Foreground="{StaticResource LabelBrush}"
                           VerticalAlignment="Center"/>
                <ui:ToggleSwitch Grid.Column="1"
                                 IsChecked="{Binding RunAtStartup, Mode=TwoWay}"/>
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="取消"
                    Width="80" Height="32"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <ui:Button x:Name="SaveButton"
                       Content="保存"
                       Width="80" Height="32"
                       Appearance="Primary"
                       Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
