<ui:FluentWindow x:Class="ShutdownGuard.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="IdlePulse"
                 Width="580" Height="960"
                 MinWidth="540" MinHeight="700"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen"
                 Icon="/Assets/IdlePulse.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="IdlePulse">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/IdlePulse-512.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Hero header -->
        <Grid Grid.Row="1" Margin="28,8,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Source="/Assets/IdlePulse-512.png"
                   Width="56" Height="56"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="IdlePulse"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="Automatically shut down, sleep, hibernate, or lock when idle."
                           Opacity="0.7"
                           Margin="0,4,0,0" />
            </StackPanel>
            <ui:Button Grid.Column="2"
                       x:Name="AppSettingsButton"
                       VerticalAlignment="Center"
                       Appearance="Secondary"
                       Padding="10"
                       ToolTip="Settings"
                       Click="AppSettingsButton_Click">
                <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
            </ui:Button>
        </Grid>

        <!-- Live status banner -->
        <Border Grid.Row="2" Margin="28,4,28,8"
                Padding="20,16"
                CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status icon -->
                <Border Grid.Column="0" Grid.RowSpan="5"
                        x:Name="StatusIconBg"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="#1A22C55E"
                        VerticalAlignment="Top"
                        Margin="0,2,16,0">
                    <ui:SymbolIcon x:Name="StatusIcon"
                                   Symbol="CheckmarkCircle24"
                                   FontSize="22"
                                   Foreground="#22C55E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <!-- Headline + Enable button -->
                <TextBlock Grid.Column="1" Grid.Row="0"
                           x:Name="StatusHeadline"
                           Text="Active"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center" />

                <ui:Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="5"
                           x:Name="EnableButton"
                           Click="EnableButton_Click"
                           VerticalAlignment="Center"
                           Padding="18,8"
                           MinWidth="110">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="EnableButtonIcon"
                                       Symbol="Power24"
                                       FontSize="16"
                                       Margin="0,0,8,0" />
                        <TextBlock x:Name="EnableButtonText"
                                   Text="Disable"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Description -->
                <TextBlock Grid.Column="1" Grid.Row="1"
                           x:Name="StatusDescription"
                           Text="Shutdown when idle for 30 minutes"
                           Opacity="0.7"
                           FontSize="12"
                           Margin="0,2,12,0" />

                <!-- Live progress -->
                <TextBlock Grid.Column="1" Grid.Row="2"
                           x:Name="StatusLive"
                           Text="Idle 0s  ·  Fires in 30m"
                           FontSize="11"
                           Opacity="0.55"
                           Margin="0,8,12,0" />

                <!-- Progress bar -->
                <ProgressBar Grid.Column="1" Grid.Row="3"
                             x:Name="StatusProgress"
                             Height="3"
                             Minimum="0" Maximum="100" Value="0"
                             Margin="0,6,12,0"
                             Background="{DynamicResource ControlFillColorTertiaryBrush}"
                             Foreground="#22C55E"
                             BorderThickness="0" />

                <!-- Scan frequency line + high-freq warning chip -->
                <StackPanel Grid.Column="1" Grid.Row="4"
                            Orientation="Horizontal"
                            Margin="0,8,12,0">
                    <ui:SymbolIcon Symbol="Pulse24"
                                   FontSize="12"
                                   Opacity="0.55"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                    <TextBlock x:Name="ScanFrequencyText"
                               Text="Scanning every 5s"
                               FontSize="11"
                               Opacity="0.55"
                               VerticalAlignment="Center" />
                    <Border x:Name="HighFreqWarning"
                            Visibility="Collapsed"
                            Margin="10,0,0,0"
                            Padding="8,2"
                            CornerRadius="4"
                            Background="#33F59E0B"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24"
                                           FontSize="12"
                                           Foreground="#F59E0B"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="High frequency monitoring"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#F59E0B"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cards -->
        <ScrollViewer Grid.Row="3" Padding="20,4,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Action -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="WeatherMoon24"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Action when idle" FontWeight="SemiBold" />
                            <TextBlock Text="What to do once the threshold is reached."
                                       Opacity="0.65" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  x:Name="ActionCombo"
                                  Width="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnAnyChanged">
                            <ComboBoxItem Tag="Shutdown">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Power24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Shutdown" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="Sleep">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Sleep" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="Hibernate">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Snooze24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Hibernate" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="Lock">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Lock" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </ui:Card>

                <!-- Idle threshold (hr / min / sec) -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Timer24"
                                           FontSize="22"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Idle threshold" FontWeight="SemiBold" />
                                <TextBlock Text="Trigger after no keyboard or mouse activity for this long."
                                           Opacity="0.65" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="36,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Hours" Opacity="0.7" FontSize="11" Margin="0,0,0,4" />
                                <ui:NumberBox x:Name="HoursBox"
                                              Value="0" Minimum="0" Maximum="23"
                                              ClearButtonEnabled="False"
                                              SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Minutes" Opacity="0.7" FontSize="11" Margin="0,0,0,4" />
                                <ui:NumberBox x:Name="MinutesBox"
                                              Value="30" Minimum="0" Maximum="59"
                                              ClearButtonEnabled="False"
                                              SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Seconds" Opacity="0.7" FontSize="11" Margin="0,0,0,4" />
                                <ui:NumberBox x:Name="SecondsBox"
                                              Value="0" Minimum="0" Maximum="59"
                                              ClearButtonEnabled="False"
                                              SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Warning countdown -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Alert24"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Warning countdown" FontWeight="SemiBold" />
                            <TextBlock Text="Seconds to cancel before the action fires."
                                       Opacity="0.65" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:NumberBox x:Name="WarningSecondsBox"
                                          Value="30" Minimum="5" Maximum="1800"
                                          ClearButtonEnabled="False"
                                          SpinButtonPlacementMode="Inline"
                                          Width="120" />
                            <TextBlock Text="sec" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Smart skips -->
                <ui:Card Margin="8,4,8,8" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="ShieldCheckmark24"
                                           FontSize="22"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Smart skips" FontWeight="SemiBold" />
                                <TextBlock Text="Don't trigger when you're clearly busy."
                                           Opacity="0.65" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="36,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Skip when a fullscreen app is running" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Grid.Column="1"
                                             x:Name="SkipFullscreenToggle"
                                             Checked="OnAnyChanged"
                                             Unchecked="OnAnyChanged" />
                        </Grid>
                        <Grid Margin="36,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Skip during presentation mode" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Grid.Column="1"
                                             x:Name="SkipPresentingToggle"
                                             Checked="OnAnyChanged"
                                             Unchecked="OnAnyChanged" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Startup -->
                <ui:Card Margin="8,4,8,12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Play24"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Run when Windows starts" FontWeight="SemiBold" />
                            <TextBlock Text="Launch IdlePulse automatically at sign-in."
                                       Opacity="0.65" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2"
                                         x:Name="StartupToggle"
                                         VerticalAlignment="Center"
                                         Checked="OnAnyChanged"
                                         Unchecked="OnAnyChanged" />
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="4" Padding="28,12,28,16"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="PendingHeadline"
                               Text="No pending changes"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.85" />
                    <TextBlock x:Name="PendingDetail"
                               Text="Your settings are saved."
                               FontSize="11"
                               Opacity="0.55"
                               Margin="0,2,12,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="CancelButton" Content="Cancel"
                               Margin="0,0,8,0" Padding="20,6" Click="CancelButton_Click" />
                    <ui:Button x:Name="SaveButton" Content="Save"
                               Appearance="Primary" Padding="22,6"
                               IsEnabled="False"
                               Click="SaveButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
