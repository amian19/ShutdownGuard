<Window x:Class="ShutdownGuard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ShutdownGuard"
        Width="420" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#555555"/>
        <SolidColorBrush x:Key="HintBrush" Color="#6B6B6B"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ShutdownGuard"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource TitleBrush}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Auto shutdown -->
                <TextBlock Text="自动关机"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启用自动关机"
                               VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                </Grid>

                <!-- Reminder -->
                <TextBlock Text="提醒开始时间"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox x:Name="HourComboBox"
                              Width="72" Height="32"
                              IsEnabled="{Binding Enabled}"
                              SelectedItem="{Binding ReminderHour, Mode=TwoWay}"
                              ItemStringFormat="{}{0:D2}"/>
                    <TextBlock Text=":"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0"/>
                    <ComboBox x:Name="MinuteComboBox"
                              Width="72" Height="32"
                              IsEnabled="{Binding Enabled}"
                              SelectedItem="{Binding ReminderMinute, Mode=TwoWay}"
                              ItemStringFormat="{}{0:D2}"/>
                </StackPanel>
                <TextBlock Text="到点后进入提醒期，直到当天固定关机时间。"
                           FontSize="11"
                           Foreground="{StaticResource HintBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="ValidationErrorText"
                           Text="{Binding ValidationError}"
                           FontSize="11"
                           Foreground="#C62828"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Fixed + plan status -->
                <TextBlock Text="关机计划"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="固定关机时间" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FixedShutdownDisplay}"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="下次提醒" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding NextReminderText}"
                               Foreground="{StaticResource SecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="本次计划关机" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ScheduledShutdownText}"
                               Foreground="{StaticResource SecondaryBrush}"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               MaxWidth="220"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Safety -->
                <TextBlock Text="安全设置"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="安全测试模式"
                               VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding DryRun, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Text="开启后会正常提醒，但最终不会真正关机。日常使用请保持开启。"
                           FontSize="11"
                           Foreground="{StaticResource HintBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="DryRunWarningText"
                           Text="警告：关闭后，到达关机时间将执行强制关机（shutdown /s /f /t 0）。"
                           FontSize="11"
                           Foreground="#C05600"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,20"/>

                <!-- DEBUG: custom test shutdown clock -->
                <StackPanel x:Name="DebugTestSection" Margin="0,0,0,20">
                    <TextBlock Text="开发测试"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启用测试关机时间"
                                   VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding UseTestShutdownTime, Mode=TwoWay}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                IsEnabled="{Binding UseTestShutdownTime}">
                        <ComboBox x:Name="TestShutdownHourComboBox"
                                  Width="72" Height="32"
                                  SelectedItem="{Binding TestShutdownHour, Mode=TwoWay}"
                                  ItemStringFormat="{}{0:D2}"/>
                        <TextBlock Text=":"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                        <ComboBox x:Name="TestShutdownMinuteComboBox"
                                  Width="72" Height="32"
                                  SelectedItem="{Binding TestShutdownMinute, Mode=TwoWay}"
                                  ItemStringFormat="{}{0:D2}"/>
                    </StackPanel>
                    <TextBlock Text="开启后：到你设的时刻走完整关机流程（仍受安全测试模式约束）。正式版始终 22:00，忽略此项。"
                               FontSize="11"
                               Foreground="{StaticResource HintBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- System -->
                <TextBlock Text="系统设置"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开机自动启动" VerticalAlignment="Center"/>
                        <TextBlock Text="登录 Windows 后自动运行（不可关闭）"
                                   FontSize="11"
                                   Foreground="{StaticResource HintBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="已开启"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Width="80" Height="32"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <ui:Button x:Name="SaveButton"
                       Content="保存"
                       Width="80" Height="32"
                       Appearance="Primary"
                       Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
