<Window x:Class="ShutdownGuard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ShutdownGuard"
        Width="420" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#555555"/>
        <SolidColorBrush x:Key="HintBrush" Color="#6B6B6B"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ShutdownGuard"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource TitleBrush}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Today shutdown: ON = shut down today, OFF = skip today -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="今日关机"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding TodayWillShutdown, Mode=TwoWay}"/>
                </Grid>

                <!-- Reminder -->
                <TextBlock Text="提醒开始时间"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox x:Name="HourComboBox"
                              Width="72" Height="32"
                              SelectedItem="{Binding ReminderHour, Mode=TwoWay}"
                              ItemStringFormat="{}{0:D2}"/>
                    <TextBlock Text=":"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0"/>
                    <ComboBox x:Name="MinuteComboBox"
                              Width="72" Height="32"
                              SelectedItem="{Binding ReminderMinute, Mode=TwoWay}"
                              ItemStringFormat="{}{0:D2}"/>
                </StackPanel>
                <TextBlock x:Name="ValidationErrorText"
                           Text="{Binding ValidationError}"
                           FontSize="11"
                           Foreground="#C62828"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Fixed + plan status -->
                <TextBlock Text="状态"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="关机时间" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FixedShutdownDisplay}"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="下次提醒" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding NextReminderText}"
                               Foreground="{StaticResource SecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="计划关机" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ScheduledShutdownText}"
                               Foreground="{StaticResource SecondaryBrush}"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               MaxWidth="220"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- System -->
                <TextBlock Text="系统设置"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开机自动启动" VerticalAlignment="Center"/>
                        <TextBlock Text="登录 Windows 后自动运行（不可关闭）"
                                   FontSize="11"
                                   Foreground="{StaticResource HintBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="已开启"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Width="80" Height="32"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <ui:Button x:Name="SaveButton"
                       Content="保存"
                       Width="80" Height="32"
                       Appearance="Primary"
                       Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
