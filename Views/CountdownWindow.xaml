<ui:FluentWindow x:Class="ShutdownGuard.Views.CountdownWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="IdlePulse"
                 Width="460" Height="340"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Topmost="True"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ShowInTaskbar="True"
                 Icon="/Assets/IdlePulse.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="IdlePulse">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/IdlePulse-512.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0">
            <Grid HorizontalAlignment="Center" Width="160" Height="160">
                <Ellipse x:Name="RingBackground"
                         Stroke="#22FFFFFF"
                         StrokeThickness="10" />
                <ui:ProgressRing x:Name="ProgressRing"
                                 IsIndeterminate="False"
                                 Progress="100"
                                 Width="160" Height="160" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="CountdownText"
                               Text="30"
                               HorizontalAlignment="Center"
                               FontSize="56"
                               FontWeight="SemiBold" />
                    <TextBlock Text="seconds"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Opacity="0.65"
                               Margin="0,-4,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ActionText"
                       Text="System will shut down"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,18,0,4" />
            <TextBlock Text="Move the mouse, press a key, or click Cancel to stop."
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Opacity="0.65"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Padding="28,12,28,20">
            <ui:Button x:Name="CancelButton"
                       Content="Cancel"
                       Appearance="Primary"
                       HorizontalAlignment="Stretch"
                       Padding="0,8"
                       Click="CancelButton_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="DismissCircle24" />
                </ui:Button.Icon>
            </ui:Button>
        </Border>
    </Grid>
</ui:FluentWindow>
