<Window x:Class="ShutdownGuard.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ShutdownGuard"
        Width="380" Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        Topmost="True"
        Loaded="Window_Loaded">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ShutdownGuard"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="#1A1A1A"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="#222222"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2"
                   Text="{Binding ShutdownAtText}"
                   FontSize="14"
                   Foreground="#333333"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="3"
                   Text="{Binding RemainingText}"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="#111111"
                   VerticalAlignment="Top"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="隐藏到托盘"
                    Width="110" Height="32"
                    Margin="0,0,8,0"
                    Click="HideToTray_Click"/>
            <ui:Button Content="取消本次关机"
                       Width="120" Height="32"
                       Appearance="Primary"
                       IsEnabled="{Binding CanCancel}"
                       Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
